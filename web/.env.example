# Copie para .env.local e preencha com a configuração do app Web do Firebase
# (Console > Configurações do projeto > Seus apps). Esses valores não são segredos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = usa os emuladores locais (desenvolvimento). Em produção, false.
VITE_USE_EMULATORS=true
